SECRET_KEY=your-django-secret-key-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/gym_saas

FRONTEND_URL=http://localhost:5173

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WABA_ID=your-whatsapp-business-account-id
# Template names must match the approved templates in WhatsApp Manager exactly.
WHATSAPP_TEMPLATE_NAME=payment_receipt
WHATSAPP_WELCOME_TEMPLATE_NAME=member_welcome
WHATSAPP_REMINDER_TEMPLATE_NAME=membership_expiry_notice
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_API_VERSION=v22.0
# Delivery-status webhook, served at /webhooks/whatsapp/.
# VERIFY_TOKEN: any string you invent; paste the same one into the Meta app's
# webhook config, which echoes it back on the one-time verification GET.
# APP_SECRET: Meta app secret (App Settings -> Basic). Signs every webhook POST.
# Leave it blank only on a local tunnel — unset means payloads are not verified.
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_APP_SECRET=your-meta-app-secret
